<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_app">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="20dp" android:background="@color/bg_white">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous" android:background="@drawable/bg_input"
            android:contentDescription="Back"/>
        <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Pembayaran"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:gravity="center"/>
        <View android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:gravity="center">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Total Pembayaran" android:textSize="12sp"
                android:textColor="@color/text_secondary" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/tv_total" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Rp 0"
                android:textSize="28sp" android:textStyle="bold" android:textColor="@color/primary"
                android:layout_marginBottom="24dp"/>

            <!-- QR Area / Bank Info / Instruction area -->
            <androidx.cardview.widget.CardView xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/bg_white" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <!-- QRIS panel -->
                    <LinearLayout android:id="@+id/panel_qris"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center">
                        <LinearLayout android:layout_width="180dp" android:layout_height="180dp"
                            android:gravity="center" android:background="@drawable/bg_input">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="▣" android:textSize="120sp" android:textColor="@color/text_primary"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Berlaku: " android:textSize="12sp" android:textColor="@color/text_secondary"/>
                            <TextView android:id="@+id/tv_timer"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="05:00" android:textSize="14sp" android:textStyle="bold"
                                android:textColor="@color/accent"/>
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Buka app e-wallet kamu, scan QR di atas, lalu konfirmasi pembayaran."
                            android:textSize="12sp" android:textColor="@color/text_secondary"
                            android:gravity="center" android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.5"/>
                    </LinearLayout>

                    <!-- Transfer panel -->
                    <LinearLayout android:id="@+id/panel_transfer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Transfer ke rekening berikut:" android:textSize="13sp"
                            android:textColor="@color/text_secondary" android:layout_marginBottom="14dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:background="@drawable/bg_input" android:padding="14dp"
                            android:layout_marginBottom="10dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="BCA" android:textSize="11sp" android:textColor="@color/text_secondary"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="1234 5678 9012" android:textSize="16sp" android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="a.n. KantinKu Utama" android:textSize="11sp"
                                    android:textColor="@color/text_secondary"/>
                            </LinearLayout>
                            <TextView android:id="@+id/btn_copy"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Salin" android:textSize="12sp" android:textStyle="bold"
                                android:textColor="@color/primary" android:background="@drawable/bg_tag_green"
                                android:paddingStart="12dp" android:paddingEnd="12dp"
                                android:paddingTop="6dp" android:paddingBottom="6dp"/>
                        </LinearLayout>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Transfer tepat sesuai nominal termasuk kode unik. Konfirmasi setelah transfer."
                            android:textSize="12sp" android:textColor="@color/text_secondary"
                            android:lineSpacingMultiplier="1.5"/>
                    </LinearLayout>

                    <!-- Tunai panel -->
                    <LinearLayout android:id="@+id/panel_tunai"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:gravity="center" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🧾" android:textSize="60sp" android:layout_marginBottom="12dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Bayar ke Kasir" android:textSize="16sp" android:textStyle="bold"
                            android:textColor="@color/text_primary" android:gravity="center"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Tunjukkan nomor pesanan di bawah kepada kasir dan bayar langsung."
                            android:textSize="12sp" android:textColor="@color/text_secondary"
                            android:gravity="center" android:layout_marginTop="8dp" android:lineSpacingMultiplier="1.5"/>
                        <TextView android:id="@+id/tv_order_code"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="#KTN-0000" android:textSize="24sp" android:textStyle="bold"
                            android:textColor="@color/primary" android:gravity="center"
                            android:background="@drawable/bg_tag_green" android:padding="14dp"
                            android:layout_marginTop="16dp"/>
                    </LinearLayout>

                    <!-- E-wallet panel -->
                    <LinearLayout android:id="@+id/panel_ewallet"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Pilih E-Wallet:" android:textSize="13sp" android:textStyle="bold"
                            android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>
                        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:columnCount="2" android:useDefaultMargins="false">
                            <LinearLayout android:id="@+id/btn_gopay"
                                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                                android:gravity="center" android:orientation="horizontal"
                                android:background="@drawable/bg_input" android:layout_marginEnd="6dp" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🟢 GoPay" android:textSize="13sp" android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>
                            <LinearLayout android:id="@+id/btn_ovo"
                                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                                android:gravity="center" android:orientation="horizontal"
                                android:background="@drawable/bg_input" android:layout_marginStart="6dp" android:layout_marginBottom="8dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🟣 OVO" android:textSize="13sp" android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>
                            <LinearLayout android:id="@+id/btn_dana"
                                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                                android:gravity="center" android:orientation="horizontal"
                                android:background="@drawable/bg_input" android:layout_marginEnd="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🔵 DANA" android:textSize="13sp" android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>
                            <LinearLayout android:id="@+id/btn_shopeepay"
                                android:layout_width="0dp" android:layout_height="64dp" android:layout_columnWeight="1"
                                android:gravity="center" android:orientation="horizontal"
                                android:background="@drawable/bg_input" android:layout_marginStart="6dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="🟠 ShopeePay" android:textSize="13sp" android:textStyle="bold"
                                    android:textColor="@color/text_primary"/>
                            </LinearLayout>
                        </GridLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:background="@color/bg_white">
        <Button android:id="@+id/btn_confirm" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Konfirmasi Pembayaran" android:textColor="@color/text_white"
            android:textSize="15sp" android:textStyle="bold"
            android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
