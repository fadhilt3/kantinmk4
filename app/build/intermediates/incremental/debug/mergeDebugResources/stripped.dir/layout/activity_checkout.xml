<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_app">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="20dp" android:background="@color/bg_white">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous" android:background="@drawable/bg_input"
            android:contentDescription="Back"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Checkout" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:gravity="center"/>
        <View android:layout_width="40dp" android:layout_height="40dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Ringkasan Pesanan" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/bg_white" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tv_order_summary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="13sp" android:textColor="@color/text_secondary"
                        android:lineSpacingMultiplier="1.8"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginTop="12dp" android:layout_marginBottom="12dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="6dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Biaya Layanan" android:textSize="13sp" android:textColor="@color/text_secondary"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Rp 2.000" android:textSize="13sp" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Total" android:textSize="15sp" android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                        <TextView android:id="@+id/tv_total"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Rp 0" android:textSize="15sp" android:textStyle="bold"
                            android:textColor="@color/primary"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Metode Pembayaran" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>

            <!-- QRIS -->
            <LinearLayout android:id="@+id/card_qris" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="16dp"
                android:layout_marginBottom="10dp" android:background="@drawable/bg_card">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_input" android:layout_marginEnd="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📲" android:textSize="20sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="QRIS" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Scan &amp; bayar dari semua e-wallet" android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <TextView android:id="@+id/radio_qris" android:layout_width="20dp" android:layout_height="20dp"
                    android:text="●" android:textSize="14sp" android:textColor="@color/primary" android:gravity="center"/>
            </LinearLayout>

            <!-- Transfer -->
            <LinearLayout android:id="@+id/card_transfer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="16dp"
                android:layout_marginBottom="10dp" android:background="@drawable/bg_card">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_input" android:layout_marginEnd="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🏦" android:textSize="20sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Transfer Bank" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="BCA, Mandiri, BNI, BRI" android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <TextView android:id="@+id/radio_transfer" android:layout_width="20dp" android:layout_height="20dp"
                    android:text="○" android:textSize="14sp" android:textColor="@color/text_hint" android:gravity="center"/>
            </LinearLayout>

            <!-- Tunai -->
            <LinearLayout android:id="@+id/card_tunai" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="16dp"
                android:layout_marginBottom="10dp" android:background="@drawable/bg_card">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_input" android:layout_marginEnd="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💵" android:textSize="20sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Bayar di Tempat" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Ambil &amp; bayar langsung ke kasir" android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <TextView android:id="@+id/radio_tunai" android:layout_width="20dp" android:layout_height="20dp"
                    android:text="○" android:textSize="14sp" android:textColor="@color/text_hint" android:gravity="center"/>
            </LinearLayout>

            <!-- E-Wallet -->
            <LinearLayout android:id="@+id/card_ewallet" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:padding="16dp"
                android:layout_marginBottom="10dp" android:background="@drawable/bg_card">
                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:gravity="center" android:background="@drawable/bg_input" android:layout_marginEnd="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💳" android:textSize="20sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="E-Wallet" android:textSize="14sp" android:textStyle="bold"
                        android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="GoPay, OVO, DANA, ShopeePay" android:textSize="11sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <TextView android:id="@+id/radio_ewallet" android:layout_width="20dp" android:layout_height="20dp"
                    android:text="○" android:textSize="14sp" android:textColor="@color/text_hint" android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/bg_white"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="20dp">
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginBottom="12dp"/>
        <Button android:id="@+id/btn_pay" android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Bayar Sekarang" android:textColor="@color/text_white"
            android:textSize="15sp" android:textStyle="bold"
            android:background="@drawable/bg_btn_primary" android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
