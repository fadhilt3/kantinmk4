<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="38dp" android:layout_height="38dp"
            android:src="@android:drawable/ic_media_previous" android:background="@drawable/bg_chip"
            android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="💵 Bayar di Tempat" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/white_full" android:gravity="center" />
        <View android:layout_width="38dp" android:layout_height="38dp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🧾" android:textSize="72sp" android:gravity="center"
                android:layout_marginTop="20dp" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Siapkan Uang Pasmu!" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/white_full" android:layout_marginBottom="6dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Total yang harus dibayar" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/white_50" android:layout_marginBottom="14dp" />
            <TextView android:id="@+id/tv_total"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Rp 0" android:textSize="30sp" android:textStyle="bold"
                android:textColor="@color/orange_primary" android:gravity="center"
                android:background="@drawable/bg_tag_orange" android:padding="16dp"
                android:layout_marginBottom="20dp" />

            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/card_secondary" app:cardElevation="0dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="① Pesanan kamu akan segera diproses\n② Datang ke Kantin Utama untuk ambil\n③ Bayar ke kasir dengan uang pas\n④ Tunjukkan nomor pesanan dari notifikasi"
                    android:textSize="11sp" android:textStyle="bold" android:textColor="@color/white_85"
                    android:lineSpacingMultiplier="1.8" android:padding="14dp" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
        <Button android:id="@+id/btn_confirm" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Konfirmasi Pesanan ✅" android:textColor="@color/white_full" android:textSize="15sp"
            android:textStyle="bold" android:background="@drawable/bg_button_orange" android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
