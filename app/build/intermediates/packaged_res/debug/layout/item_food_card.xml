<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/bg_white"
    app:cardElevation="3dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">

        <!-- Foto / Emoji Box -->
        <FrameLayout android:layout_width="62dp" android:layout_height="62dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:id="@+id/img_food"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_input"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/layout_emoji"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:gravity="center"
                android:background="@drawable/bg_input">
                <TextView android:id="@+id/tv_emoji"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🍳" android:textSize="28sp"/>
            </LinearLayout>

        </FrameLayout>

        <!-- Info -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="3dp">
                <TextView android:id="@+id/tv_name"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Nama Menu"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:maxLines="1"/>
                <TextView android:id="@+id/tv_badge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔥 Hits" android:textSize="9sp" android:textStyle="bold"
                    android:textColor="@color/accent" android:background="@drawable/bg_tag_red"
                    android:paddingStart="6dp" android:paddingEnd="6dp"
                    android:paddingTop="2dp" android:paddingBottom="2dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <TextView android:id="@+id/tv_kantin"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Kantin Utama" android:textSize="11sp"
                android:textColor="@color/text_secondary" android:layout_marginBottom="5dp"/>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⭐" android:textSize="11sp"/>
                <TextView android:id="@+id/tv_rating"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="4.8" android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" android:layout_marginStart="3dp"/>
                <TextView android:id="@+id/tv_review"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="(128)" android:textSize="10sp"
                    android:textColor="@color/text_hint" android:layout_marginStart="3dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tv_price"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Rp 13.000"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="@color/primary"/>
                <ImageView
                    android:id="@+id/btn_favorite"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:src="@drawable/ic_favorite_border"
                    android:layout_marginEnd="8dp"
                    android:padding="4dp"/>
                <TextView android:id="@+id/btn_add"
                    android:layout_width="32dp" android:layout_height="32dp"
                    android:text="+" android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/text_white" android:gravity="center"
                    android:background="@drawable/bg_qty"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>