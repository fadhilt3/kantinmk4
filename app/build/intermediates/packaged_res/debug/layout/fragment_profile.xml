<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_app">

    <!-- Profile Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_primary_gradient"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="24dp" android:paddingBottom="28dp" android:gravity="center">

        <LinearLayout android:id="@+id/avatar_view"
            android:layout_width="72dp" android:layout_height="72dp"
            android:gravity="center" android:background="@color/bg_white"
            android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tv_avatar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AK" android:textSize="24sp" android:textStyle="bold"
                android:textColor="@color/primary"/>
        </LinearLayout>

        <TextView android:id="@+id/tv_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nama User" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/text_white"/>
        <TextView android:id="@+id/tv_email"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="email@email.com" android:textSize="12sp"
            android:textColor="#CCFFFFFF" android:layout_marginTop="3dp"/>
        <TextView android:id="@+id/tv_username_badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@username" android:textSize="11sp" android:textStyle="bold"
            android:textColor="@color/primary_light" android:background="@color/primary_dark"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:layout_marginTop="8dp"/>

        <!-- Stats -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="20dp"
            android:background="@color/primary_dark" android:padding="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="15" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="@color/text_white"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pesanan" android:textSize="10sp" android:textColor="#AAFFFFFF"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#33FFFFFF"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="6" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="@color/text_white"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Favorit" android:textSize="10sp" android:textColor="#AAFFFFFF"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="28dp" android:background="#33FFFFFF"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="4.9⭐" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="@color/text_white"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Rating" android:textSize="10sp" android:textColor="#AAFFFFFF"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/bg_app"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@color/bg_white">

                <LinearLayout android:id="@+id/row_history"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🕐  Riwayat Pesanan" android:textSize="14sp" android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_hint"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="20dp"/>

                <LinearLayout android:id="@+id/row_notif"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="🔔  Notifikasi" android:textSize="14sp" android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_hint"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="20dp"/>

                <LinearLayout android:id="@+id/row_favorites"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="❤️  Favorit Saya" android:textSize="14sp" android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_hint"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="20dp"/>

                <LinearLayout android:id="@+id/row_settings"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="⚙️  Pengaturan" android:textSize="14sp" android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_hint"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginStart="20dp"/>

                <LinearLayout android:id="@+id/row_about"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="ℹ️  Tentang Aplikasi" android:textSize="14sp" android:textColor="@color/text_primary"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="20sp" android:textColor="@color/text_hint"/>
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="8dp" android:background="@color/bg_app"/>

            <LinearLayout android:id="@+id/row_logout"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:background="@color/bg_white">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="🚪  Keluar" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/error"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
