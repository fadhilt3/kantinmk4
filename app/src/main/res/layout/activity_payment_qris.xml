<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_primary">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="38dp" android:layout_height="38dp"
            android:src="@android:drawable/ic_media_previous" android:background="@drawable/bg_chip"
            android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="📲 Bayar QRIS" android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/white_full" android:gravity="center" />
        <View android:layout_width="38dp" android:layout_height="38dp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center" android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Total Pembayaran" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/white_50" android:layout_marginBottom="4dp" />
            <TextView android:id="@+id/tv_total"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Rp 0" android:textSize="26sp" android:textStyle="bold"
                android:textColor="@color/orange_primary" android:layout_marginBottom="20dp" />

            <!-- QR Code Placeholder -->
            <androidx.cardview.widget.CardView android:layout_width="200dp" android:layout_height="200dp"
                app:cardCornerRadius="18dp" app:cardBackgroundColor="@color/card_secondary"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▣" android:textSize="100sp" android:textColor="@color/white_full" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="QR CODE" android:textSize="10sp" android:textStyle="bold"
                        android:textColor="@color/white_50" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Berlaku selama  " android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/white_50" />
                <TextView android:id="@+id/tv_timer"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="05:00" android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/orange_primary" />
            </LinearLayout>

            <!-- Steps -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/card_secondary"
                app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Cara Bayar:" android:textSize="11sp" android:textStyle="bold"
                        android:textColor="@color/white_full" android:layout_marginBottom="10dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="① Buka aplikasi dompet digital kamu\n② Pilih menu Scan QR / Bayar\n③ Arahkan ke QR Code di atas\n④ Konfirmasi &amp; selesaikan pembayaran"
                        android:textSize="11sp" android:textStyle="bold" android:textColor="@color/white_85"
                        android:lineSpacingMultiplier="1.8" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
        <Button android:id="@+id/btn_paid" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="Sudah Bayar ✅" android:textColor="@color/white_full" android:textSize="15sp"
            android:textStyle="bold" android:background="@drawable/bg_button_orange" android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
